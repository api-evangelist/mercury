{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mercury API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mercury.com/api/v1/accounts"
          },
          "docs": "List accounts"
        },
        {
          "info": {
            "name": "Get an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mercury.com/api/v1/accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Mercury account ID."
              }
            ]
          },
          "docs": "Get an account"
        }
      ]
    },
    {
      "info": {
        "name": "Cards",
