              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List transactions for an account"
        },
        {
          "info": {
            "name": "Get a single transaction for an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mercury.com/api/v1/accounts/:id/transactions/:transactionId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Mercury account ID."
