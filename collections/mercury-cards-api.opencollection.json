{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mercury Accounts Cards API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List cards for an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mercury.com/api/v1/accounts/:id/cards",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Mercury account ID."
              }
            ]
          },
          "docs": "List cards for an account"
        }
      ]
    }
  ],
  "bundled": true
}